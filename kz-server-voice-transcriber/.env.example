VOICE_TRANSCRIBE_TOKEN=
VOICE_API_PORT=3030
# auto, ru, en, or another Whisper language code. A fixed code is faster and
# more reliable for short clips; individual requests may override this value.
VOICE_TRANSCRIBE_LANGUAGE=auto

# Local TTS routing. Language can also be sent as auto, ru, or en in the request body.
TTS_DEFAULT_LANGUAGE=ru
TTS_RU_PROVIDER=silero
TTS_EN_PROVIDER=piper
# Optional fallback: edge, silero, or piper. Empty means disabled.
TTS_FALLBACK_PROVIDER=

# Edge TTS is used by /api/tts or as the explicitly configured fallback.
EDGE_TTS_VOICE_RU=ru-RU-DmitryNeural
EDGE_TTS_VOICE_EN=en-US-GuyNeural

# Local Russian Silero model configuration.
SILERO_LANGUAGE=ru
# Silero v5_5_ru is distributed under a non-commercial model license.
SILERO_MODEL_ID=v5_5_ru
SILERO_SPEAKER=eugene
# Set to 1 only when an old torch hub cache must be refreshed manually.
SILERO_FORCE_RELOAD=0

# Local English Piper model. Relative paths are resolved from this directory.
# Female: ./models/piper/en_US-lessac-medium.onnx
# Male:   ./models/piper/en_US-hfc_male-medium.onnx
PIPER_MODEL_PATH=./models/piper/en_US-lessac-medium.onnx
# Empty means <PIPER_MODEL_PATH>.json
PIPER_CONFIG_PATH=
PYTHON_BIN=python3

VOICE_MAX_UPLOAD_MB=50
VOICE_MAX_QUEUE_SIZE=20
VOICE_MAX_TTS_QUEUE_SIZE=20
VOICE_MAX_TTS_CHARS=10000
VOICE_TTS_TIMEOUT_MS=300000
VOICE_TMP_MAX_AGE_HOURS=24

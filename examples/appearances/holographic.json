  "shell": {
    "version": 1,
    "scope": "workspace",
    "language": "html",
    "source": "<style>\n  :root {\n    --bg: #07151a;\n    --panel: #0b242c;\n    --ink: #c2f1ee;\n    --muted: #8ab4bc;\n    --line: #27505b;\n    --glow: #79e1de;\n    color-scheme: dark;\n  }\n  html,\n  body {\n    height: 100%;\n    overflow: hidden;\n  }\n  body {\n    margin: 0;\n    background: var(--bg) !important;\n    color: var(--ink) !important;\n    font:\n      14px/1.6 \"Segoe UI\",\n      system-ui,\n      sans-serif !important;\n  }\n  button,\n  input,\n  select,\n  textarea {\n    font: inherit;\n  }\n  button {\n    cursor: pointer;\n  }\n  button:focus-visible,\n  input:focus-visible,\n  select:focus-visible,\n  textarea:focus-visible {\n    outline: 2px solid var(--glow);\n    outline-offset: 4px;\n  }\n  button {\n    color: inherit;\n  }\n  button:disabled {\n    opacity: 0.45;\n    cursor: default;\n  }\n  .scene {\n    height: 100%;\n    position: relative;\n    isolation: isolate;\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n    background:\n      radial-gradient(ellipse at 70% 25%, #12323c99, transparent 65%), var(--bg);\n  }\n  .scene:before {\n    content: \"\";\n    position: absolute;\n    inset: -20%;\n    z-index: -1;\n    pointer-events: none;\n    background-image:\n      linear-gradient(#27505b26 1px, transparent 1px),\n      linear-gradient(90deg, #27505b26 1px, transparent 1px);\n    background-size: 48px 48px;\n    mask-image: radial-gradient(ellipse, black, transparent 70%);\n    animation: drift 36s linear infinite;\n  }\n  .scene:after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: 3;\n    background: repeating-linear-gradient(\n      transparent 0,\n      transparent 3px,\n      #07151a1a 4px\n    );\n    opacity: 0.35;\n  }\n  .top {\n    padding: 23px clamp(18px, 4vw, 50px) 17px;\n    display: flex;\n    gap: 20px;\n    align-items: center;\n    justify-content: space-between;\n    border-bottom: 1px solid var(--line);\n  }\n  .brand {\n    font:\n      500 13px/1.5 ui-monospace,\n      Consolas,\n      monospace;\n    letter-spacing: 0.15em;\n  }\n  .brand span {\n    display: inline-block;\n    width: 7px;\n    height: 7px;\n    margin-right: 12px;\n    background: var(--glow);\n    border-radius: 50%;\n    box-shadow: 0 0 12px var(--glow);\n  }\n  .counter {\n    font:\n      11px/1.5 ui-monospace,\n      Consolas,\n      monospace;\n    letter-spacing: 0.1em;\n    color: var(--muted);\n  }\n  .nav {\n    display: flex;\n    gap: 10px;\n    padding: 16px clamp(18px, 4vw, 50px);\n    align-items: center;\n    flex-wrap: wrap;\n  }\n  input,\n  select,\n  textarea {\n    color: var(--ink);\n    border: 1px solid var(--line);\n    border-radius: 3px;\n    background: var(--panel);\n    padding: 10px 13px;\n    min-width: 0;\n    box-sizing: border-box;\n  }\n  .search {\n    flex: 1;\n    min-width: 120px;\n    max-width: 430px;\n  }\n  input::placeholder,\n  textarea::placeholder {\n    color: var(--muted);\n  }\n  .control {\n    border: 1px solid var(--line);\n    background: var(--panel);\n    padding: 9px 15px;\n    border-radius: 3px;\n    transition:\n      background 0.2s,\n      box-shadow 0.2s;\n  }\n  .control:hover {\n    background: #153640;\n    box-shadow: 0 0 20px #79e1de0a;\n  }\n  .control.primary {\n    border-color: #79e1de66;\n    background: #12383e;\n  }\n  .scroll {\n    overflow: auto;\n    min-height: 0;\n    flex: 1;\n    scrollbar-color: var(--line) transparent;\n    scrollbar-width: thin;\n    overscroll-behavior: contain;\n  }\n  .map {\n    height: 440px;\n    max-width: 1080px;\n    margin: auto;\n    position: relative;\n  }\n  .ring {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 300px;\n    height: 300px;\n    margin: -150px 0 0 -150px;\n    border: 1px solid var(--line);\n    border-radius: 50%;\n    pointer-events: none;\n    box-shadow:\n      0 0 80px #79e1de05,\n      inset 0 0 80px #79e1de05;\n  }\n  .ring:before {\n    content: \"\";\n    position: absolute;\n    inset: 33px;\n    border: 1px dashed #46747c66;\n    border-radius: 50%;\n    animation: rotate 90s linear infinite;\n  }\n  .ring:after {\n    content: \"\";\n    position: absolute;\n    inset: 75px;\n    border: 1px solid #27505b99;\n    border-radius: 50%;\n  }\n  .center {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    transform: translate(-50%, -50%);\n    text-align: center;\n    pointer-events: none;\n  }\n  .center b {\n    font:\n      400 20px/1.5 ui-monospace,\n      Consolas,\n      monospace;\n    letter-spacing: 0.18em;\n    display: block;\n  }\n  .center span {\n    display: block;\n    color: var(--muted);\n    font:\n      10px/1.6 ui-monospace,\n      Consolas,\n      monospace;\n    letter-spacing: 0.14em;\n    margin-top: 8px;\n  }\n  .channel {\n    position: relative;\n    text-align: left;\n    padding: 18px 21px;\n    border: 1px solid var(--line);\n    background: linear-gradient(135deg, #0c2730, #0a2028);\n    color: var(--ink);\n    box-sizing: border-box;\n    min-width: 0;\n    transition:\n      transform 0.25s ease,\n      border-color 0.25s ease,\n      box-shadow 0.25s ease;\n    overflow: hidden;\n    border-radius: 2px;\n  }\n  .channel:before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 24px;\n    height: 2px;\n    background: var(--glow);\n    opacity: 0.65;\n  }\n  .channel:after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(\n      110deg,\n      transparent 20%,\n      #79e1de0d 45%,\n      transparent 65%\n    );\n    transform: translateX(-120%);\n    transition: transform 0.7s ease;\n    pointer-events: none;\n  }\n  .channel:hover {\n    transform: translateY(-4px);\n    border-color: #79e1de80;\n    box-shadow:\n      0 8px 35px #0003,\n      inset 0 0 28px #79e1de06;\n  }\n  .channel:hover:after {\n    transform: translateX(120%);\n  }\n  .channel[aria-current=\"true\"] {\n    border-color: #79e1de99;\n    background: linear-gradient(135deg, #12343d, #0a2028);\n  }\n  .channel strong {\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n    overflow: hidden;\n    font-size: 16px;\n    line-height: 1.4;\n    font-weight: 500;\n    margin: 9px 0 14px;\n    overflow-wrap: anywhere;\n  }\n  .channel time,\n  .channel small {\n    font:\n      11px/1.5 ui-monospace,\n      Consolas,\n      monospace;\n    color: var(--muted);\n  }\n  .channel small {\n    display: block;\n    color: var(--glow);\n    opacity: 0.8;\n  }\n  .map .channel {\n    position: absolute;\n    width: 29%;\n    max-width: 290px;\n    min-height: 132px;\n    clip-path: polygon(\n      0 0,\n      calc(100% - 13px) 0,\n      100% 13px,\n      100% 100%,\n      13px 100%,\n      0 calc(100% - 13px)\n    );\n  }\n  .map .channel:focus-visible {\n    clip-path: none;\n  }\n  .map .channel:nth-of-type(1) {\n    left: 5%;\n    top: 27px;\n  }\n  .map .channel:nth-of-type(2) {\n    right: 5%;\n    top: 60px;\n  }\n  .map .channel:nth-of-type(3) {\n    left: 9%;\n    bottom: 35px;\n  }\n  .map .channel:nth-of-type(4) {\n    right: 2%;\n    bottom: 14px;\n  }\n  .more-channels {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));\n    gap: 15px;\n    max-width: 1040px;\n    margin: 15px auto 30px;\n    padding: 0 20px;\n  }\n  .more-channels .channel {\n    content-visibility: auto;\n    contain-intrinsic-size: auto 130px;\n  }\n  .bottom {\n    padding: 8px 20px 30px;\n    display: flex;\n    justify-content: center;\n  }\n  .empty {\n    padding: 80px 25px;\n    text-align: center;\n    color: var(--muted);\n  }\n  .conversation {\n    flex: 1;\n    min-height: 0;\n    display: flex;\n    flex-direction: column;\n  }\n  .thread-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 12px;\n    padding: 16px clamp(18px, 4vw, 50px);\n    border-bottom: 1px solid var(--line);\n  }\n  .thread-head h1 {\n    font-size: 18px;\n    font-weight: 500;\n    margin: 0;\n    overflow-wrap: anywhere;\n  }\n  .thread-actions {\n    display: flex;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .messages {\n    flex: 1;\n    min-height: 0;\n    overflow: auto;\n    overscroll-behavior: contain;\n    scrollbar-color: var(--line) transparent;\n    padding: 25px max(20px, calc((100% - 840px) / 2));\n    scroll-behavior: smooth;\n  }\n  .message {\n    margin: 0 0 30px;\n    content-visibility: auto;\n    contain-intrinsic-size: auto 130px;\n  }\n  .message .meta {\n    font:\n      11px/1.5 ui-monospace,\n      Consolas,\n      monospace;\n    letter-spacing: 0.1em;\n    color: var(--muted);\n    margin-bottom: 10px;\n  }\n  .message .body {\n    white-space: pre-wrap;\n    overflow-wrap: anywhere;\n    padding: 17px 20px;\n    background: #0d2830;\n    border-left: 2px solid #79e1de77;\n  }\n  .message.user {\n    margin-left: 15%;\n  }\n  .message.user .body {\n    background: #0b2028;\n    border-left-color: var(--line);\n  }\n  .message.fresh {\n    animation: transmit 0.35s ease-out both;\n  }\n  .message.assistant .body {\n    box-shadow: inset 14px 0 28px #79e1de04;\n  }\n  .typing {\n    color: var(--muted);\n    font:\n      12px/1.6 ui-monospace,\n      Consolas,\n      monospace;\n    padding: 0 0 20px;\n    letter-spacing: 0.1em;\n  }\n  .typing span {\n    display: inline-block;\n    width: 5px;\n    height: 5px;\n    background: var(--glow);\n    margin-right: 10px;\n    box-shadow: 0 0 10px #79e1de77;\n    animation: pulse 2s ease-in-out infinite;\n  }\n  .composer {\n    padding: 12px max(20px, calc((100% - 840px) / 2)) 22px;\n    border-top: 1px solid var(--line);\n    display: flex;\n    gap: 10px;\n    align-items: flex-end;\n    background: #091c23;\n  }\n  .composer textarea {\n    flex: 1;\n    resize: none;\n    min-height: 64px;\n    max-height: 160px;\n    padding: 14px;\n  }\n  .composer-actions {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .composer .control {\n    white-space: nowrap;\n  }\n  .attachment-count {\n    color: var(--muted);\n    font-size: 12px;\n  }\n  [hidden] {\n    display: none !important;\n  }\n  @keyframes drift {\n    to {\n      transform: translate(48px, 48px);\n    }\n  }\n  @keyframes rotate {\n    to {\n      transform: rotate(360deg);\n    }\n  }\n  @keyframes pulse {\n    50% {\n      opacity: 0.3;\n    }\n  }\n  @keyframes transmit {\n    from {\n      opacity: 0;\n      transform: translateY(6px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n  html[data-paused=\"true\"] *,\n  html[data-paused=\"true\"] *:before {\n    animation-play-state: paused !important;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    *,\n    *:before,\n    *:after {\n      animation: none !important;\n      transition: none !important;\n      scroll-behavior: auto !important;\n    }\n  }\n  @media (max-width: 650px) {\n    .top {\n      padding: 18px;\n    }\n    .counter {\n      font-size: 10px;\n    }\n    .nav {\n      padding: 14px 18px;\n    }\n    .nav select {\n      max-width: 150px;\n    }\n    .map {\n      height: 480px;\n    }\n    .map .channel {\n      width: 43%;\n      padding: 14px;\n      min-height: 145px;\n    }\n    .map .channel:nth-of-type(1) {\n      left: 3%;\n      top: 10px;\n    }\n    .map .channel:nth-of-type(2) {\n      right: 3%;\n      top: 32px;\n    }\n    .map .channel:nth-of-type(3) {\n      left: 3%;\n      bottom: 45px;\n    }\n    .map .channel:nth-of-type(4) {\n      right: 3%;\n      bottom: 20px;\n    }\n    .ring {\n      width: 240px;\n      height: 240px;\n      margin: -120px 0 0 -120px;\n    }\n    .center b {\n      font-size: 16px;\n    }\n    .channel strong {\n      font-size: 14px;\n    }\n    .thread-head {\n      align-items: flex-start;\n      flex-direction: column;\n    }\n    .messages {\n      padding: 20px;\n    }\n    .message.user {\n      margin-left: 8%;\n    }\n    .composer {\n      padding: 12px 16px;\n    }\n    .composer-actions .control {\n      padding: 9px;\n    }\n    .more-channels {\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n    }\n    .more-channels .channel {\n      padding: 13px;\n    }\n  }\n  @media (max-width: 380px) {\n    .more-channels {\n      grid-template-columns: 1fr;\n    }\n    .brand {\n      font-size: 11px;\n      letter-spacing: 0.08em;\n    }\n    .counter {\n      letter-spacing: 0;\n    }\n    .nav .control {\n      padding: 9px;\n    }\n    .composer {\n      gap: 7px;\n    }\n    .composer textarea {\n      padding: 10px;\n    }\n    .composer-actions .control {\n      font-size: 12px;\n    }\n  }\n</style>\n<div class=\"scene\">\n  <header class=\"top\">\n    <div class=\"brand\"><span></span>VEGA / ARCHIVE</div>\n    <div class=\"counter\" id=\"counter\"></div>\n  </header>\n  <div id=\"archive\" class=\"conversation\">\n    <nav class=\"nav\" aria-label=\"Chats\">\n      <input\n        id=\"search\"\n        class=\"search\"\n        type=\"search\"\n        maxlength=\"200\"\n        autocomplete=\"off\"\n      />\n      <select id=\"folder\" aria-label=\"Folder\"></select>\n      <button id=\"new\" class=\"control primary\" type=\"button\"></button>\n    </nav>\n    <div class=\"scroll\" id=\"archive-scroll\">\n      <div class=\"map\" id=\"map\">\n        <div class=\"ring\" aria-hidden=\"true\"></div>\n        <div class=\"center\"><b>ДИАЛОГИ</b><span>ПАМЯТЬ РАЗГОВОРОВ</span></div>\n      </div>\n      <div class=\"more-channels\" id=\"remaining\"></div>\n      <div id=\"empty\" class=\"empty\" hidden></div>\n      <div class=\"bottom\">\n        <button class=\"control\" id=\"more\" type=\"button\" hidden></button>\n      </div>\n    </div>\n  </div>\n  <main id=\"conversation\" class=\"conversation\" hidden>\n    <header class=\"thread-head\">\n      <h1 id=\"chat-title\"></h1>\n      <div class=\"thread-actions\">\n        <button class=\"control\" id=\"back\" type=\"button\">← Карта</button\n        ><button class=\"control\" id=\"native\" type=\"button\">\n          Действия чата ↗\n        </button>\n      </div>\n    </header>\n    <div class=\"messages\" id=\"messages\" role=\"log\" aria-label=\"Messages\"></div>\n    <form class=\"composer\" id=\"composer\">\n      <textarea\n        id=\"draft\"\n        rows=\"2\"\n        maxlength=\"100000\"\n        aria-label=\"Message\"\n      ></textarea>\n      <div class=\"composer-actions\">\n        <button class=\"control primary\" type=\"submit\" id=\"send\"></button\n        ><button class=\"control\" type=\"button\" id=\"attach\"></button>\n      </div>\n    </form>\n  </main>\n</div>\n<script>\n  (() => {\n    const $ = (id) => document.getElementById(id);\n    const bridge = window.chatter;\n    if (!bridge) {\n      $(\"counter\").textContent = \"Откройте этот код через оформление Chatter\";\n      return;\n    }\n    let state,\n      selectedFolder = \"all\",\n      view = \"archive\",\n      requestedChat = null;\n    let archiveSignature = \"\",\n      folderSignature = \"\";\n    let messageNodes = new Map();\n    let lastChat = null;\n    let creatingFrom = undefined;\n    const channelNodes = new Map();\n    const ru = () => (state?.locale || \"\").startsWith(\"ru\");\n    function text(russian, english) {\n      return ru() ? russian : english;\n    }\n    function makeChannel(chat) {\n      const button = document.createElement(\"button\");\n      button.type = \"button\";\n      button.className = \"channel\";\n      button.innerHTML = \"<time></time><strong></strong><small></small>\";\n      button.onclick = () => {\n        requestedChat = chat.id;\n        view = \"conversation\";\n        bridge.openChat(chat.id);\n        render();\n        $(\"draft\").focus();\n      };\n      return button;\n    }\n    function updateArchive() {\n      const folders = [\n        { value: \"all\", name: state.labels.allChats },\n        { value: \"unfiled\", name: text(\"Без папки\", \"Unfiled\") },\n        ...state.folders.map((folder) => ({\n          value: String(folder.id),\n          name: folder.name,\n        })),\n      ];\n      if (!folders.some((folder) => folder.value === selectedFolder))\n        selectedFolder = \"all\";\n      const nextFolderSignature = JSON.stringify(folders);\n      if (nextFolderSignature !== folderSignature) {\n        $(\"folder\").replaceChildren(\n          ...folders.map((folder) => {\n            const option = document.createElement(\"option\");\n            option.value = folder.value;\n            option.textContent = folder.name;\n            return option;\n          }),\n        );\n        $(\"folder\").value = selectedFolder;\n        folderSignature = nextFolderSignature;\n      }\n      const chats = state.chats\n        .filter(\n          (chat) =>\n            selectedFolder === \"all\" ||\n            (selectedFolder === \"unfiled\"\n              ? chat.folderId === null\n              : chat.folderId === Number(selectedFolder)),\n        )\n        .slice()\n        .sort((a, b) => b.updatedAt - a.updatedAt || b.id - a.id);\n      const signature = JSON.stringify([\n        chats,\n        selectedFolder,\n        state.activeChatId,\n        state.locale,\n      ]);\n      if (signature !== archiveSignature) {\n        const liveIds = new Set(chats.map((chat) => chat.id));\n        for (const [id, button] of channelNodes) {\n          if (!liveIds.has(id)) {\n            button.remove();\n            channelNodes.delete(id);\n          }\n        }\n        chats.forEach((chat, index) => {\n          const button = channelNodes.get(chat.id) || makeChannel(chat);\n          channelNodes.set(chat.id, button);\n          button.title = chat.title;\n          button.setAttribute(\n            \"aria-current\",\n            String(chat.id === state.activeChatId),\n          );\n          button.querySelector(\"strong\").textContent = chat.title;\n          button.querySelector(\"time\").textContent = new Date(\n            chat.updatedAt * 1000,\n          ).toLocaleDateString(state.locale, {\n            day: \"numeric\",\n            month: \"short\",\n          });\n          button.querySelector(\"small\").textContent = text(\n            \"Открыть канал ↗\",\n            \"Open channel ↗\",\n          );\n          (index < 4 ? $(\"map\") : $(\"remaining\")).append(button);\n        });\n        archiveSignature = signature;\n      }\n      $(\"map\").hidden = !chats.length;\n      $(\"remaining\").hidden = chats.length <= 4;\n      $(\"empty\").hidden = chats.length > 0 && !state.loading;\n      $(\"empty\").textContent = state.loading\n        ? state.labels.loading\n        : state.labels.empty;\n      const pending =\n        state.query.trim().length >= 3\n          ? []\n          : state.sections.filter(\n              (section) =>\n                section.hasMore &&\n                (selectedFolder === \"all\" ||\n                  (selectedFolder === \"unfiled\"\n                    ? section.folderId === null\n                    : section.folderId === Number(selectedFolder))),\n            );\n      $(\"more\").hidden = pending.length === 0;\n      $(\"more\").disabled = pending.every((section) => section.loading);\n      $(\"more\").textContent = state.labels.loadMore;\n      $(\"counter\").textContent =\n        text(\"КАНАЛОВ\", \"CHANNELS\") + \" / \" + chats.length;\n      $(\"new\").textContent = state.labels.newChat;\n      $(\"search\").placeholder = state.labels.search;\n      if (document.activeElement !== $(\"search\"))\n        $(\"search\").value = state.query;\n    }\n    function updateConversation() {\n      const ready =\n        state.activeChatId === requestedChat && !state.messagesLoading;\n      const chat = state.chats.find((chat) => chat.id === requestedChat);\n      $(\"chat-title\").textContent =\n        chat?.title || text(\"Разговор\", \"Conversation\");\n      $(\"back\").textContent = text(\"← Карта\", \"← Map\");\n      $(\"native\").textContent = text(\"Действия чата ↗\", \"Chat actions ↗\");\n      $(\"draft\").placeholder = text(\"Введите сообщение…\", \"Write a message…\");\n      $(\"draft\").disabled = !ready || !state.canSend;\n      $(\"attach\").textContent =\n        text(\"Файл\", \"Attach\") +\n        (state.attachmentCount ? \" · \" + state.attachmentCount : \"\");\n      $(\"send\").textContent = state.sending\n        ? text(\"Остановить\", \"Stop\")\n        : text(\"Отправить\", \"Send\");\n      $(\"send\").disabled =\n        !ready ||\n        (!state.sending && (!state.canSend || !$(\"draft\").value.trim()));\n      const panel = $(\"messages\");\n      const nearBottom =\n        panel.scrollHeight - panel.scrollTop - panel.clientHeight < 100;\n      const chatChanged = lastChat !== requestedChat;\n      if (chatChanged) {\n        panel.replaceChildren();\n        messageNodes.clear();\n        lastChat = requestedChat;\n      }\n      let older = panel.querySelector(\"[data-older]\");\n      if (!older) {\n        older = document.createElement(\"button\");\n        older.type = \"button\";\n        older.className = \"control\";\n        older.dataset.older = \"\";\n        older.onclick = () => bridge.loadOlderMessages();\n        panel.prepend(older);\n      }\n      older.hidden = !ready || !state.hasOlderMessages;\n      older.disabled = state.olderMessagesLoading;\n      older.textContent = text(\"Предыдущие сообщения\", \"Earlier messages\");\n      const rows = ready\n        ? state.messages.filter((message) => message.content.trim())\n        : [];\n      const liveIds = new Set(rows.map((message) => message.id));\n      for (const [id, node] of messageNodes)\n        if (!liveIds.has(id)) {\n          node.remove();\n          messageNodes.delete(id);\n        }\n      const typing = panel.querySelector(\".typing\");\n      if (typing) typing.remove();\n      const previousHeight = panel.scrollHeight;\n      const previousTop = panel.scrollTop;\n      const insertingOlder =\n        rows.length && messageNodes.size && !messageNodes.has(rows[0].id);\n      rows.forEach((message) => {\n        let node = messageNodes.get(message.id);\n        if (!node) {\n          node = document.createElement(\"article\");\n          node.className =\n            \"message \" + (message.role === \"user\" ? \"user\" : \"assistant\");\n          if (!chatChanged && !insertingOlder) node.classList.add(\"fresh\");\n          node.innerHTML = '<div class=\"meta\"></div><div class=\"body\"></div>';\n          messageNodes.set(message.id, node);\n        }\n        node.querySelector(\".meta\").textContent =\n          (message.role === \"user\" ? text(\"ВЫ\", \"YOU\") : \"VEGA\") +\n          \" / \" +\n          new Date(message.createdAt * 1000).toLocaleTimeString(state.locale, {\n            hour: \"2-digit\",\n            minute: \"2-digit\",\n          });\n        const body = node.querySelector(\".body\");\n        if (body.textContent !== message.content)\n          body.textContent = message.content;\n        const next = panel.children[rows.indexOf(message) + 1];\n        if (next !== node) panel.insertBefore(node, next || null);\n      });\n      if (!ready || state.sending) {\n        const label = document.createElement(\"div\");\n        label.className = \"typing\";\n        label.innerHTML = \"<span></span>\";\n        label.append(\n          document.createTextNode(\n            !ready\n              ? state.labels.loading\n              : text(\"СИГНАЛ ПОСТУПАЕТ\", \"RECEIVING SIGNAL\"),\n          ),\n        );\n        panel.append(label);\n      }\n      if (chatChanged || nearBottom) panel.scrollTop = panel.scrollHeight;\n      else if (insertingOlder)\n        panel.scrollTop = previousTop + panel.scrollHeight - previousHeight;\n    }\n    function render() {\n      if (!state) return;\n      $(\"archive\").hidden = view !== \"archive\";\n      $(\"conversation\").hidden = view !== \"conversation\";\n      updateArchive();\n      if (view === \"conversation\") updateConversation();\n    }\n    bridge.subscribe(\n      (next) => {\n        if (\n          creatingFrom !== undefined &&\n          next.activeChatId &&\n          next.activeChatId !== creatingFrom\n        ) {\n          requestedChat = next.activeChatId;\n          creatingFrom = undefined;\n        }\n        if (next.view === \"home\") view = \"archive\";\n        else if (next.view === \"conversation\") {\n          view = \"conversation\";\n          if (creatingFrom === undefined) requestedChat = next.activeChatId;\n        }\n        state = next;\n        render();\n      },\n      { navigation: true },\n    );\n    $(\"search\").addEventListener(\"input\", (event) =>\n      bridge.search(event.target.value),\n    );\n    $(\"folder\").onchange = (event) => {\n      selectedFolder = event.target.value;\n      archiveSignature = \"\";\n      render();\n    };\n    $(\"new\").onclick = () => {\n      creatingFrom = state.activeChatId;\n      view = \"conversation\";\n      requestedChat = null;\n      bridge.newChat();\n    };\n    $(\"more\").onclick = () => {\n      const section = state.sections.find(\n        (section) =>\n          section.hasMore &&\n          !section.loading &&\n          (selectedFolder === \"all\" ||\n            (selectedFolder === \"unfiled\"\n              ? section.folderId === null\n              : section.folderId === Number(selectedFolder))),\n      );\n      if (section) bridge.loadMore(section.folderId);\n    };\n    $(\"back\").onclick = () => bridge.showHome();\n    $(\"native\").onclick = () => bridge.openConversation();\n    $(\"attach\").onclick = () => bridge.attachFiles();\n    $(\"draft\").addEventListener(\"input\", () => {\n      if (state)\n        $(\"send\").disabled =\n          !state.sending && (!state.canSend || !$(\"draft\").value.trim());\n    });\n    $(\"draft\").addEventListener(\"keydown\", (event) => {\n      if (event.key === \"Enter\" && !event.shiftKey && !event.isComposing) {\n        event.preventDefault();\n        $(\"composer\").requestSubmit();\n      }\n    });\n    $(\"composer\").onsubmit = (event) => {\n      event.preventDefault();\n      if (state.sending) {\n        bridge.stopGeneration();\n        return;\n      }\n      const value = $(\"draft\").value.trim();\n      if (value && state.canSend && bridge.sendMessage(value)) {\n        $(\"draft\").value = \"\";\n        $(\"send\").disabled = true;\n      }\n    };\n    document.addEventListener(\"visibilitychange\", () => {\n      document.documentElement.dataset.paused = String(document.hidden);\n    });\n  })();\n</script>\n"
  }

# Required Telegram access settings
MONITOR_BOT_TOKEN=
MONITOR_ADMIN_ID=

# OpenAI-compatible API used to interpret commands and logs
MONITOR_AI_API_KEY=
MONITOR_AI_BASE_URL=
MONITOR_AI_MODEL=qwen/qwen-2.5-7b-instruct

# PM2 command limits
MONITOR_PM2_ALLOWED_TARGETS=chatter,chatter-api,webapp-notes,watchdog,kz-voice
MONITOR_PM2_LOG_LINES=120
MONITOR_PM2_TIMEOUT_MS=20000
MONITOR_REPO_TIMEOUT_MS=600000

# Local state
MONITOR_DB_PATH=./watchdog.db
MONITOR_HISTORY_LIMIT=10
MONITOR_HISTORY_ITEM_MAX_CHARS=1200

# Optional repository paths
MONITOR_CHATTER_PATH=~/chatter
MONITOR_WEBAPP_NOTES_PATH=~/chatter/webapp-notes
MONITOR_WATCHDOG_PATH=~/chatter/server-monitor-bot

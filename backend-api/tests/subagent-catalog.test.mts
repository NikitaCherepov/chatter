import assert from 'node:assert/strict';
import os from 'node:os';
import path from 'node:path';
process.env.API_DB_PATH = path.join(os.tmpdir(), `chatter-subagent-catalog-${process.pid}-${Date.now()}.sqlite`);
const { parseSubagentPrompt } = await import('../src/services/subagents/prompt-metadata.js');
const { listSubagentCatalog, listSubagentNames, getSubagent, clearPromptCache, validateSubagentCatalogMetadata } = await import('../src/services/subagents/registry.js');
const prompt = '# Role\nKeep this prompt exactly.\n';
const parsed = parseSubagentPrompt(`---\nname_key: custom.some_name\ndescription_key: "custom.some_description"\n---\n\n${prompt}`);
assert.deepEqual(parsed.metadata, { nameKey: 'custom.some_name', descriptionKey: 'custom.some_description' });
assert.equal(parsed.body, prompt);
assert.equal(parseSubagentPrompt('---\nname_key: a.b\ndescription_key: c.d\nicon: file\n---\nBody').metadata?.icon, 'file');
assert.equal(parseSubagentPrompt('---\nname_key: a.b\ndescription_key: c.d\nicon: future-icon\n---\nBody').metadata?.icon, 'future-icon');
assert.throws(() => parseSubagentPrompt('---\nname_key: a.b\ndescription_key: c.d\nicon: <svg>\n---\nBody'), /Invalid/);

assert.deepEqual(parseSubagentPrompt(prompt), { body: prompt });
assert.equal(parseSubagentPrompt('\uFEFF---\r\nname_key: a.b\r\ndescription_key: c.d\r\n---\r\n\r\nBody').body, 'Body');
assert.throws(() => parseSubagentPrompt('---\nname_key: a.b\n---\nBody'), /requires name_key and description_key/);
assert.throws(() => parseSubagentPrompt('---\nname_key: a.b'), /Unclosed/);
assert.throws(() => parseSubagentPrompt('---\nname_key: a.b\nname_key: c.d\ndescription_key: e.f\n---\nBody'), /Invalid/);
assert.deepEqual(validateSubagentCatalogMetadata(), []);
const missing = validateSubagentCatalogMetadata(key => key !== 'subagents.file_converter.name');
assert.equal(missing.length, 1);
assert(missing[0].includes('file-converter.md') && missing[0].includes('subagents.file_converter.name'));
const { hasBackendTextTranslation } = await import('../src/i18n/index.js');
assert.equal(hasBackendTextTranslation('subagents'), false, 'translation objects are not display strings');
assert.equal(hasBackendTextTranslation('does.not.exist'), false);
const en = listSubagentCatalog('en');
const ru = listSubagentCatalog('ru');
assert.deepEqual(en.map(agent => agent.id), listSubagentNames());
assert.equal(en.find(agent => agent.id === 'file_converter')?.name, 'Video converter');
assert.equal(ru.find(agent => agent.id === 'file_converter')?.name, 'Конвертер видео');
assert.notEqual(ru[0].description, en[0].description);
assert.equal(en.find(agent => agent.id === 'file_converter')?.icon, 'file');
assert.equal(en.find(agent => agent.id === 'news_researcher')?.icon, 'search');
assert.deepEqual(ru.map(agent => agent.icon), en.map(agent => agent.icon));
assert.deepEqual(listSubagentCatalog('unsupported-language'), en);
for (const agent of en) {
  assert.deepEqual(Object.keys(agent).sort(), ['description', 'icon', 'id', 'name']);
  assert(agent.name.length > 0 && agent.description.length > 0);
  assert(!agent.name.startsWith('subagents.') && !agent.description.startsWith('subagents.'));
  const loaded = getSubagent(agent.id);
  assert(!loaded.systemPrompt.startsWith('---'));
  assert(!loaded.systemPrompt.includes('name_key:'));
  assert(!loaded.systemPrompt.includes('icon:'));
}
const original = en[0].description;
en[0].description = 'changed client-side';
assert.equal(listSubagentCatalog('en')[0].description, original);
clearPromptCache();
assert.equal(listSubagentCatalog('ru')[0].name, ru[0].name);
console.log('Subagent MD metadata: parsing, prompt stripping, RU/EN localization, language fallback, and public-only catalog passed.');

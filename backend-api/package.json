{
  "name": "chatter-backend-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync:languages": "node ../scripts/sync-languages.mjs",
    "predev": "npm run sync:languages",
    "dev": "tsx src/server.ts",
    "test:monitor": "tsx tests/openrouter-monitor.test.mts",
    "build": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/i18n/locales','dist/i18n/locales',{ recursive: true })\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^4.1.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.8.0",
    "gpt-tokenizer": "^3.4.0",
    "i18next": "^26.3.6",
    "mailparser": "^3.9.8",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "mqtt": "^5.15.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.46.0",
    "pdf-parse": "^2.4.5",
    "proxy-agent": "^8.0.2",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "imapflow": "^1.4.7",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}

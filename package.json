{
  "name": "chatter-bot",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx index.ts",
    "start": "pm2 start index.ts --interpreter tsx --name chatter",
    "restart": "pm2 restart chatter --update-env",
    "stop": "pm2 stop chatter",
    "logs": "pm2 logs chatter"
  },
  "dependencies": {
    "@tavily/core": "latest",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.5",
    "openai": "^4.0.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}

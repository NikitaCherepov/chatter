{
  "name": "chatter-bot",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:api": "tsc -p backend-api/tsconfig.json",
    "i18n:extract:bot": "node scripts/extract-bot-i18n.mjs --source index.ts --catalog i18n/locales/ru/translation.json",
    "i18n:extract:bot:ai": "node scripts/extract-bot-i18n.mjs --source index.ts --catalog i18n/locales/ru/translation.json --env .env.i18n --ai-keys",
    "i18n:audit:bot": "node scripts/audit-bot-i18n.mjs --source index.ts",
    "i18n:audit:bot:all": "node scripts/audit-bot-i18n.mjs --source index.ts --all --fail-on none",
    "i18n:translate:bot": "node scripts/translate-i18n.mjs --locales i18n/locales --env .env.i18n --from en",
    "i18n:translate:bot:all": "node scripts/translate-i18n.mjs --locales i18n/locales --env .env.i18n --from en --all",
    "i18n:translate:desktop": "node scripts/translate-i18n.mjs --locales desktop-app/src/renderer/i18n/locales --env .env.i18n",
    "i18n:translate:desktop:all": "node scripts/translate-i18n.mjs --locales desktop-app/src/renderer/i18n/locales --env .env.i18n --from en --all",
    "i18n:translate:api": "node scripts/translate-i18n.mjs --locales backend-api/src/i18n/locales --env .env.i18n --from en",
    "i18n:translate:api:all": "node scripts/translate-i18n.mjs --locales backend-api/src/i18n/locales --env .env.i18n --from en --all",
    "i18n:translate:notes": "node scripts/translate-i18n.mjs --locales webapp-notes/i18n/locales --env .env.i18n --from en",
    "i18n:translate:notes:all": "node scripts/translate-i18n.mjs --locales webapp-notes/i18n/locales --env .env.i18n --from en --all",
    "dev": "tsx index.ts",
    "dev:api": "tsx backend-api/src/server.ts",
    "start": "pm2 start index.ts --interpreter tsx --name chatter",
    "start:api": "pm2 start backend-api/src/server.ts --interpreter tsx --name chatter-api",
    "restart": "pm2 restart chatter --update-env",
    "restart:api": "pm2 restart chatter-api --update-env",
    "stop": "pm2 stop chatter",
    "stop:api": "pm2 stop chatter-api",
    "logs": "pm2 logs chatter",
    "logs:api": "pm2 logs chatter-api",
    "security:secrets": "node scripts/security/scan-secrets.mjs --mode all --report .secret-scan-report.json --fail-on high"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^7.2.0",
    "@tavily/core": "latest",
    "axios": "^1.15.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "i18next": "^26.3.6",
    "imapflow": "^1.3.2",
    "mailparser": "^3.9.8",
    "marked": "^18.0.5",
    "openai": "^4.0.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}

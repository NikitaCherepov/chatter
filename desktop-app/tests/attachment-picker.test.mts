import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import { createRequire } from 'node:module';
const require = createRequire(import.meta.url);
const { AttachmentPicker } = require('../src/main/attachment-picker.ts');
const root = await fs.mkdtemp(path.join(os.tmpdir(), 'chatter-picked-files-'));
const file = path.join(root, 'Test document.txt'); await fs.writeFile(file, 'Selected content');
const picker = new AttachmentPicker();
const selected = await picker.choose(1, async () => [file]);
assert.equal(selected.canceled, false);
assert.deepEqual(selected.files, [{ index: 0, name: 'Test document.txt', size: 16 }]);
assert.equal(JSON.stringify(selected).includes(root), false, 'file chooser metadata does not expose paths');
assert.equal(Buffer.from(await picker.read(1, selected.selectionId, 0)).toString(), 'Selected content');
await assert.rejects(picker.read(2, selected.selectionId, 0), /attachment_selection_expired/);
await assert.rejects(picker.read(1, selected.selectionId, -1), /attachment_selection_expired/);
await fs.writeFile(file, 'Changed after selection');
await assert.rejects(picker.read(1, selected.selectionId, 0), /attachment_file_changed/);
picker.release(1, selected.selectionId);
await assert.rejects(picker.read(1, selected.selectionId, 0), /attachment_selection_expired/);
const cancelled = await picker.choose(1, async () => []);
assert.equal(cancelled.canceled, true);
let finish!: (files: string[]) => void;
const pending = picker.choose(1, () => new Promise(resolve => { finish = resolve; }));
picker.release(1); finish([file]);
assert.equal((await pending).canceled, true, 'destroyed/cancelled owners cannot regain selected-file access');
console.log('PASS: exact user-selected file tickets, byte reads, owner isolation, changed files, release and cancellation races');

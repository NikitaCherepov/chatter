import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
const require = createRequire(import.meta.url);
const { normalizeWakeWordConfig, selectWakeWord, wakeWordThreshold } = require('../src/main/wakeword-config.ts');
assert.equal(wakeWordThreshold(50), .55);
assert.equal(wakeWordThreshold(0), .85);
assert.equal(wakeWordThreshold(100), .25);
assert.equal(normalizeWakeWordConfig(null).words.length, 6);
assert.deepEqual(normalizeWakeWordConfig({words:['alexa','unknown','alexa'],sensitivity:200}), {words:['alexa'],sensitivity:100});
assert.equal(normalizeWakeWordConfig({sensitivity:NaN}).sensitivity,50);
const config = {words:['alexa'],sensitivity:50};
assert.deepEqual(selectWakeWord({hey_jarvis:.99,alexa:.6},config),{name:'alexa',score:.6});
assert.equal(selectWakeWord({hey_jarvis:.99,alexa:.54},config),null);
assert.equal(selectWakeWord({alexa:.8},{words:[],sensitivity:100}),null);
assert.equal(selectWakeWord({alexa:.4},config),null);
assert.deepEqual(selectWakeWord({alexa:.4},{...config,sensitivity:100}),{name:'alexa',score:.4});
assert.deepEqual(selectWakeWord({'5_minute_timer':.8,weather:.9},{words:['timer'],sensitivity:50}),{name:'5_minute_timer',score:.8});
assert.equal(selectWakeWord({'1_hour_timer':.9},{words:['weather'],sensitivity:50}),null);
assert.equal(selectWakeWord({'alexa':NaN},config),null);
console.log('Wake word config: defaults, bounds, disabled words, timer classes and sensitivity passed.');

import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
const require = createRequire(import.meta.url);
const { parseMessageChart: parse, chartToText, stripMessageAccents, prepareMessageAccents } = require('../src/renderer/lib/message-accents.ts');
const { MESSAGE_FORMATTING_HINT } = require('../../backend-api/src/services/system-prompt.ts');
const basic = { labels: ['A', 'B'], series: [{ name: 'First', values: [0, -12] }, { name: 'Second', values: [null, 3] }] };
const json = (value: unknown) => JSON.stringify(value);
const fence = (value: unknown) => '```chart\n' + json(value) + '\n```';
const chart = parse(json(basic));
assert.equal(chart.type, 'line'); assert.equal(chart.stacked, false); assert.equal(chart.series[0].color, 'blue');
assert.equal(chart.series[1].values[0], null);
for (const type of ['line', 'bar', 'area']) assert.equal(parse(json({ ...basic, type })).type, type);
for (const type of ['pie', 'donut']) assert.equal(parse(json({ type, labels: ['A', 'B'], series: [{ name: 'Share', values: [0, 3] }] })).type, type);
for (const extra of [ {type:'scatter'}, {stacked:true}, {stacked:'yes'}, {onClick:'x'}, {url:'https://example.org'}, {options:{}}, {labels:[]}, {labels:['A',' A ']}, {series:[]}, {series:[{name:'First',values:[1]}]}, {series:[{name:'First',values:['1',2]}]}, {series:[{name:'First',values:[null,null]}]}, {series:[{name:'First',color:'#fff',values:[1,2]}]}, {series:[{name:'First',values:[1e16,2]}]}, {series:[{name:'First',values:[1,2],onClick:'x'}]}, {series:[{name:'X',values:[1,2]},{name:'X',values:[3,4]}]} ]) assert.throws(() => parse(json({...basic,...extra})));
for (const values of [[0,0],[-1,2],[null,2]]) assert.throws(() => parse(json({type:'pie',labels:['A','B'],series:[{name:'S',values}]})));
assert.throws(() => parse(json({...basic,type:'pie'})));
assert.throws(() => parse('{"labels":["A"],"series":[{"name":"X","values":[1]}],"__proto__":{}}'));
assert.throws(() => parse(' '.repeat(200001)));
const labels = Array.from({length:500},(_,i)=>String(i));
assert.equal(parse(json({labels,series:Array.from({length:8},(_,i)=>({name:String(i),values:labels.map(Number)}))})).labels.length,500);
assert.throws(() => parse(json({labels:[...labels,'501'],series:[{name:'S',values:Array(501).fill(1)}]})));
assert.throws(() => parse(json({labels,series:Array.from({length:9},(_,i)=>({name:String(i),values:labels.map(Number)}))})));
assert.ok(chartToText(chart).includes('B: First: -12; Second: 3'));
assert.ok(!stripMessageAccents(fence(basic)).includes('```'));
assert.equal(prepareMessageAccents(fence(basic)),fence(basic));
assert.equal(stripMessageAccents(fence(basic).slice(0,-3)),fence(basic).slice(0,-3));
assert.equal(stripMessageAccents(fence({...basic,onClick:'x'})),fence({...basic,onClick:'x'}));
assert.equal(stripMessageAccents('````md\n'+fence(basic)+'\n````'),'````md\n'+fence(basic)+'\n````');
assert.ok(MESSAGE_FORMATTING_HINT.includes('language chart')); assert.doesNotMatch(MESSAGE_FORMATTING_HINT,/\b(?:telegram|desktop)\b/i);
console.log('PASS: chart schema, numeric bounds, missing data, polar rules, maximum sizes, unknown keys, fallback, streaming and prompt');

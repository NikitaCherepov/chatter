import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { createRequire } from 'node:module';
const require = createRequire(import.meta.url);
const { LocalAppearanceStore, openAppearanceWorkspace, saveAppearanceLocation, copyAppearanceWorkspace } = require('../src/main/local-appearance.ts');
const { newAppearance, parseAppearanceProfile, APPEARANCE_CAPABILITIES } = require('../src/main/appearance-schema.ts');
const { compileAppearanceProject } = require('../src/main/appearance-project.ts');
const ts = require('typescript');
const { zipSync } = require('fflate');
const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'chatter-local-themes-'));
try {
  const directory = path.join(temporary, 'themes');
  const store = new LocalAppearanceStore(directory);
  const budgetStore = new LocalAppearanceStore(path.join(temporary, 'project-budget'));
  const unicodeSource = '/*' + 'я'.repeat(250000) + '*/';
  budgetStore.writeDraft({ ...newAppearance('large-project'), shell: { version: 1, language: 'tsx', scope: 'workspace', entry: 'App.tsx',
    files: { 'App.tsx': 'export default function App(){return <main/>}', 'styles.css': unicodeSource } } });
  assert.equal(budgetStore.readDraft('large-project').shell.files['styles.css'], unicodeSource,
    'on-disk byte guards must allow UTF-8 sources within the shared character budget');
  const beforeDocs = store.load().appearance;
  const guidePath = path.join(directory, 'THEMES.md');
  assert.equal(store.readDocumentation(), fs.readFileSync(guidePath, 'utf8'));
  assert.ok(store.readDocumentation().includes('theme.json'));
  assert.ok(store.readDocumentation().includes('workLog'));
  assert.ok(fs.readFileSync(path.join(directory, 'chatter.d.ts'), 'utf8').includes('workLog:WorkLogStep[]'));
  // Editor declarations must resolve the bundled component API, not only runtime syntax.
  const virtualRoot = path.resolve('desktop-app/.theme-typecheck');
  const virtualFiles = new Map([
    [path.join(virtualRoot, 'chatter.d.ts'), fs.readFileSync(path.join(directory, 'chatter.d.ts'), 'utf8')],
    [path.join(virtualRoot, 'chatter-ui.d.ts'), fs.readFileSync(path.join(directory, 'chatter-ui.d.ts'), 'utf8')],
    [path.join(virtualRoot, 'App.tsx'), 'import React from "react";import {Markdown,MessageImages,Attachments,useChatterState} from "@chatter/ui";export default function App(){const state=useChatterState();const message=state?.messages[0];return message?<><Markdown messageId={message.id} content={message.content}/><MessageImages message={message}/><Attachments message={message}/></>:null;}'],
  ]);
  const compilerOptions = { target: ts.ScriptTarget.ES2020, module: ts.ModuleKind.ESNext, moduleResolution: ts.ModuleResolutionKind.Bundler,
    jsx: ts.JsxEmit.React, noEmit: true, strict: true, esModuleInterop: true, types: [], skipLibCheck: false };
  const compilerHost = ts.createCompilerHost(compilerOptions), originalRead = compilerHost.readFile, originalExists = compilerHost.fileExists;
  compilerHost.readFile = (file: string) => virtualFiles.get(path.normalize(file)) ?? originalRead(file);
  compilerHost.fileExists = (file: string) => virtualFiles.has(path.normalize(file)) || originalExists(file);
  compilerHost.getSourceFile = (file: string, version: any) => { const source = compilerHost.readFile(file); return source === undefined ? undefined : ts.createSourceFile(file, source, version); };
  const originalDirectoryExists = compilerHost.directoryExists;
  compilerHost.directoryExists = (file: string) => path.normalize(file) === virtualRoot || originalDirectoryExists?.(file) || false;
  const editorProgram = ts.createProgram([...virtualFiles.keys()], compilerOptions, compilerHost);
  assert.deepEqual(ts.getPreEmitDiagnostics(editorProgram).filter((item: any) => item.category === ts.DiagnosticCategory.Error)
    .map((item: any) => ts.flattenDiagnosticMessageText(item.messageText, '\n')), [], 'generated @chatter/ui declarations type-check with the real React API');
  fs.appendFileSync(guidePath, '\nUpdated desktop guide\n');
  assert.ok(store.readDocumentation().includes('Updated desktop guide'), 'docs are read from the current local file');
  assert.deepEqual(store.load().appearance, beforeDocs, 'reading docs preserves all theme settings');
  assert.equal(store.load().workspace.migrationComplete, false);
  const ordinary = newAppearance('ordinary');
  ordinary.name = 'Plain colors'; ordinary.revision = 7;
  const html = { ...newAppearance('html'), shell: { version: 1, language: 'html', source: '<main>HTML</main>' } };
  const single = { ...newAppearance('single'), shell: { version: 1, language: 'tsx', source: 'function App(){return <main>Legacy</main>}' } };
  const project = parseAppearanceProfile({ ...newAppearance('project'), shell: APPEARANCE_CAPABILITIES.shell.project.template });
  const legacy = { version: 1, revision: 9, activeId: 'ordinary', profiles: [ordinary, html, single, project] };
  const migrated = store.migrate(legacy);
  assert.equal(migrated.appearance.profiles.length, 4);
  assert.equal(migrated.appearance.activeId, 'ordinary');
  assert.deepEqual(migrated.appearance.profiles[0], ordinary);
  const plainPath = migrated.workspace.profiles.find((item: any) => item.id === 'ordinary').directory;
  assert.equal(fs.existsSync(path.join(plainPath, 'theme.json')), true);
  assert.equal(fs.existsSync(path.join(plainPath, 'App.tsx')), false, 'ordinary themes only require a manifest');
  assert.equal(JSON.parse(fs.readFileSync(path.join(plainPath, 'theme.json'), 'utf8')).light.accent, ordinary.light.accent);
  const htmlPath = migrated.workspace.profiles.find((item: any) => item.id === 'html').directory;
  assert.equal(fs.readFileSync(path.join(htmlPath, 'index.html'), 'utf8'), html.shell.source);
  assert.equal(JSON.parse(fs.readFileSync(path.join(htmlPath, 'theme.json'), 'utf8')).shell.source, undefined, 'source is materialized into real files');
  assert.deepEqual(store.readDraft('single').shell, single.shell, 'legacy single TSX keeps App fallback and exact code');
  assert.deepEqual(store.readDraft('project').shell, project.shell);
  assert.deepEqual(JSON.parse(fs.readFileSync(path.join(directory, '.migration-backup.json'), 'utf8')), legacy);
  const draftPath = path.join(directory, '.drafts', 'ordinary', 'theme.json');
  const edited = JSON.parse(fs.readFileSync(draftPath, 'utf8'));
  edited.light.accent = '#ff0000';
  fs.writeFileSync(draftPath, JSON.stringify(edited));
  assert.equal(store.readDraft('ordinary').light.accent, '#ff0000');
  assert.equal(store.load().appearance.profiles[0].light.accent, ordinary.light.accent, 'draft writes cannot mutate active settings');
  store.migrate({ ...legacy, profiles: [newAppearance('unexpected')] });
  assert.equal(store.readDraft('ordinary').light.accent, '#ff0000', 'repeat migration never overwrites a draft');
  assert.equal(store.load().appearance.profiles.some((item: any) => item.id === 'unexpected'), false);
  const next = store.save(store.readDraft('ordinary'), true);
  assert.equal(next.appearance.profiles[0].revision, 8);
  assert.equal(next.appearance.profiles[0].light.accent, '#ff0000');
  const reopened = new LocalAppearanceStore(directory);
  assert.equal(reopened.load().appearance.profiles[0].light.accent, '#ff0000', 'publication survives a restart');
  assert.throws(() => store.save(ordinary, true), /appearance_conflict/);
  const restored = store.change({ action: 'rollback', id: 'ordinary', revision: next.appearance.revision });
  assert.equal(restored.appearance.profiles[0].revision, 9, 'rollback publishes a new monotonic revision');
  assert.equal(restored.appearance.profiles[0].light.accent, ordinary.light.accent);
  const folders = fs.readdirSync(path.join(directory, '.saved', 'ordinary'));
  assert.equal(folders.length, 2, 'only the current and preceding snapshots are retained');
  const selected = restored.workspace.profiles.find((item: any) => item.id === 'ordinary').directory;
  fs.writeFileSync(path.join(selected, 'theme.json'), '{');
  const recovered = store.load();
  assert.equal(recovered.appearance.profiles[0].light.accent, '#ff0000', 'a corrupt publication falls back to the valid previous snapshot');
  assert.ok(recovered.workspace.issues.some((issue: string) => issue.includes('appearance_previous_restored')));
  assert.equal(new LocalAppearanceStore(directory).load().appearance.profiles[0].light.accent, '#ff0000');
  const projectDraft = store.prepareDraft('new-project', true).workspace.drafts.find((item: any) => item.id === 'new-project').directory;
  assert.ok(fs.existsSync(path.join(projectDraft, 'components', 'Composer.tsx')));
  assert.ok(fs.readFileSync(path.join(projectDraft, 'chatter.d.ts'), 'utf8').includes('sendMessage(text:string):boolean'));
  assert.deepEqual(compileAppearanceProject(store.readDraft('new-project').shell, ts).diagnostics, []);
  fs.mkdirSync(path.join(projectDraft, 'components', 'nested'));
  fs.writeFileSync(path.join(projectDraft, 'components', 'nested', 'index.tsx'), 'export default function Panel(){return <p>Nested</p>}');
  fs.writeFileSync(path.join(projectDraft, 'App.tsx'), 'import Panel from "@/components/nested"; import type {ThemeState} from "./chatter"; export default function App(){return <Panel/>}');
  const componentProject = store.readDraft('new-project');
  assert.ok(componentProject.shell.files['components/nested/index.tsx']);
  assert.equal(componentProject.shell.files['chatter.d.ts'], undefined);
  assert.deepEqual(compileAppearanceProject(componentProject.shell, ts).diagnostics, [], 'aliases, index files and editor-only API types work together');
  store.writeDraft({ ...componentProject, shell: { ...componentProject.shell, files: { 'App.tsx': 'export default function App(){return null}' } } });
  assert.deepEqual(Object.keys(store.readDraft('new-project').shell.files), ['App.tsx'], 'rewriting a draft removes obsolete files');
  assert.throws(() => store.readDraft('../ordinary'), /appearance_invalid/);
  const invalidStore = new LocalAppearanceStore(path.join(temporary, 'invalid'));
  const partial = invalidStore.migrate({ ...legacy, profiles: [ordinary, { ...html, id: '../escape' }] });
  assert.equal(partial.appearance.profiles.length, 1);
  assert.equal(partial.workspace.migrationErrors.length, 1);
  assert.equal(JSON.parse(fs.readFileSync(path.join(temporary, 'invalid', '.migration-backup.json'), 'utf8')).profiles.length, 2);
  const otherStore = new LocalAppearanceStore(path.join(temporary, 'other-workspace'));
  assert.equal(otherStore.load().appearance.profiles.length, 0);
  let events = 0;
  const stop = store.watch(() => events++);
  fs.writeFileSync(path.join(projectDraft, 'App.tsx'), 'export default function App(){return <p>Changed</p>}');
  await new Promise(resolve => setTimeout(resolve, 350));
  stop();
  assert.ok(events > 0, 'file changes emit events without polling');
  assert.equal(store.load().appearance.activeId, 'ordinary');
  const destination = fs.mkdtempSync(path.join(temporary, 'chosen-'));
  const relocated = copyAppearanceWorkspace(store, destination);
  assert.deepEqual(relocated.load().appearance, store.load().appearance);
  assert.equal(relocated.readDraft('ordinary').light.accent, store.readDraft('ordinary').light.accent);
  assert.ok(fs.existsSync(path.join(directory, '.state.json')), 'choosing a different directory retains the original as a backup');
  assert.deepEqual(copyAppearanceWorkspace(store, destination).load().appearance, relocated.load().appearance, 'an existing local workspace can be reopened');
  const occupied = fs.mkdtempSync(path.join(temporary, 'occupied-'));
  fs.writeFileSync(path.join(occupied, 'unrelated.txt'), 'keep');
  assert.throws(() => copyAppearanceWorkspace(store, occupied), /appearance_directory_not_empty/);
  assert.equal(copyAppearanceWorkspace(store, otherStore.directory).directory, otherStore.directory, 'another local workspace has no account ownership restriction');
  assert.throws(() => copyAppearanceWorkspace(store, path.join(directory, '.drafts')), /appearance_directory_overlap/);
  const pixel = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Y9ZlS8AAAAASUVORK5CYII=', 'base64');
  const localImage = store.importImage(pixel.toString('base64'));
  assert.ok(localImage.startsWith('chatter-theme://'));
  assert.deepEqual(store.readImage(new URL(localImage).pathname.slice(1)), pixel);
  assert.throws(() => store.importImage(Buffer.from('<svg/>').toString('base64')), /appearance_image_invalid/);
  assert.throws(() => store.readImage('../outside'), /appearance_image_invalid/);
  const withImage = { ...newAppearance('with-image'), background: { ...ordinary.background, type: 'image', image: localImage } };
  const imageSaved = store.save(withImage, false);
  const imageDirectory = imageSaved.workspace.profiles.find((item: any) => item.id === 'with-image').directory;
  const imageManifest = JSON.parse(fs.readFileSync(path.join(imageDirectory, 'theme.json'), 'utf8'));
  assert.ok(imageManifest.background.image.startsWith('assets/'));
  assert.ok(fs.existsSync(path.join(imageDirectory, imageManifest.background.image)));
  const bundle = store.exportBundle('with-image');
  const receiver = new LocalAppearanceStore(path.join(temporary, 'receiver'));
  const imported = receiver.importBundle(bundle);
  assert.notEqual(imported.id, 'with-image');
  assert.equal(imported.revision, 0);
  assert.notEqual(new URL(imported.background.image).hostname, new URL(localImage).hostname);
  assert.deepEqual(receiver.readImage(new URL(imported.background.image).pathname.slice(1)), pixel);
  assert.equal(receiver.load().appearance.profiles.length, 0, 'archive import creates only a draft');
  assert.throws(() => receiver.importBundle(zipSync({ '../escape': new Uint8Array([1]), 'theme.json': new TextEncoder().encode(JSON.stringify(ordinary)) })), /appearance_invalid_archive/);
  const imageMigration = new LocalAppearanceStore(path.join(temporary, 'image-migration'));
  const migratedImageUrl = imageMigration.importImage(pixel.toString('base64'));
  const oldImage = { ...newAppearance('old-image'), background: { ...ordinary.background, type: 'image', image: '/api/v1/images/old.png' } };
  const imageLegacy = { version: 1, revision: 0, activeId: 'old-image', profiles: [oldImage] };
  const imageMoved = imageMigration.migrate(imageLegacy, { '/api/v1/images/old.png': migratedImageUrl });
  assert.equal(imageMoved.appearance.profiles[0].background.image, migratedImageUrl);
  assert.equal(JSON.parse(fs.readFileSync(path.join(imageMigration.directory, '.migration-backup.json'), 'utf8')).profiles[0].background.image, '/api/v1/images/old.png');
  const editing = new LocalAppearanceStore(path.join(temporary, 'editing'));
  const firstEdit = editing.save(newAppearance('editable'), true).appearance.profiles[0];
  const secondEdit = editing.save({ ...firstEdit, name: 'Changed in settings' }, true).appearance.profiles[0];
  assert.equal(editing.readDraft('editable').name, 'Changed in settings', 'saving settings refreshes an unmodified working copy');
  const external = JSON.parse(fs.readFileSync(path.join(editing.directory, '.drafts/editable/theme.json'), 'utf8'));
  external.name = 'New work in files';
  fs.writeFileSync(path.join(editing.directory, '.drafts/editable/theme.json'), JSON.stringify(external));
  editing.save({ ...secondEdit, name: 'Approved snapshot' }, true);
  assert.equal(editing.readDraft('editable').name, 'New work in files', 'publishing a captured proposal preserves newer external edits');
  const appData = path.join(temporary, 'app-data');
  const oldDefault = new LocalAppearanceStore(path.join(appData, 'themes', 'a'.repeat(24)));
  const oldCustom = new LocalAppearanceStore(path.join(temporary, 'old-custom'));
  const withHistory = oldDefault.save({ ...newAppearance('duplicate'), name: 'First account theme' }, true).appearance.profiles[0];
  oldDefault.save({ ...withHistory, name: 'First account updated' }, true);
  oldCustom.save({ ...newAppearance('duplicate'), name: 'Other server theme' }, true);
  const legacyImage = oldDefault.importImage(pixel.toString('base64'));
  oldDefault.save({ ...newAppearance('local-raster'), background: { ...ordinary.background, type: 'image', image: legacyImage } }, false);
  oldDefault.writeDraft({ ...newAppearance('unfinished'), shell: { version: 1, language: 'tsx', source: 'export default function App(){return <main>Original</main>}' } });
  fs.writeFileSync(path.join(oldDefault.directory, '.drafts/unfinished/App.tsx'), 'unfinished source');
  fs.mkdirSync(path.join(oldDefault.directory, '.drafts/broken'), { recursive: true });
  fs.writeFileSync(path.join(oldDefault.directory, '.drafts/broken/theme.json'), '{broken');
  fs.renameSync(path.join(oldDefault.directory, '.workspace.json'), path.join(oldDefault.directory, '.scope.json'));
  fs.writeFileSync(path.join(appData, 'theme-locations.json'), JSON.stringify({ ['b'.repeat(24)]: oldCustom.directory }));
  const newest = new Date(Date.now() + 2000);
  fs.utimesSync(path.join(oldDefault.directory, '.state.json'), newest, newest);
  const common = openAppearanceWorkspace(appData), combined = common.load();
  assert.equal(common.directory, path.join(appData, 'themes'));
  assert.equal(combined.appearance.profiles.length, 3, 'saved themes from default and custom directories are combined');
  assert.equal(new Set(combined.appearance.profiles.map(profile => profile.id)).size, 3, 'colliding IDs never overwrite another theme');
  assert.equal(combined.appearance.profiles.find(profile => profile.id === combined.appearance.activeId)?.name, 'First account updated');
  assert.equal(combined.workspace.profiles.find(profile => profile.name === 'First account updated')?.hasPrevious, true);
  const unfinished = combined.workspace.drafts.find(draft => draft.id.startsWith('unfinished-'));
  assert.equal(fs.readFileSync(path.join(unfinished.directory, 'App.tsx'), 'utf8'), 'unfinished source');
  assert.ok(combined.workspace.drafts.some(draft => draft.id.startsWith('broken-')), 'invalid drafts are retained too');
  const migratedRaster = combined.appearance.profiles.find(profile => profile.id.startsWith('local-raster-'));
  assert.deepEqual(common.readImage(new URL(migratedRaster.background.image).pathname.slice(1)), pixel);
  assert.equal(oldDefault.load().appearance.activeId, 'duplicate', 'old workspaces remain as backups');
  assert.deepEqual(openAppearanceWorkspace(appData).load().appearance, combined.appearance, 'reopening never imports duplicates or resets selection');
  const commonMoved = fs.mkdtempSync(path.join(temporary, 'global-selected-'));
  copyAppearanceWorkspace(common, commonMoved);
  saveAppearanceLocation(appData, commonMoved);
  assert.equal(openAppearanceWorkspace(appData).directory, commonMoved, 'the selected directory belongs to the app, without account/server keys');
  assert.deepEqual(openAppearanceWorkspace(appData).load().appearance, combined.appearance);
  console.log('PASS: one app-wide workspace, legacy directories merged without ID collisions, drafts/assets/history preserved and global directory selection');
  console.log('PASS: local raster resources, portable ZIP import/export, traversal rejection and background migration with original backup');
  console.log('PASS: ordinary/HTML/TSX/project migration, backup, idempotency, drafts, atomic snapshots, rollback/recovery, bounded history, components, aliases, declarations and filesystem events');
} finally {
  assert.equal(path.dirname(path.resolve(temporary)), path.resolve(os.tmpdir()));
  assert.ok(path.basename(temporary).startsWith('chatter-local-themes-'));
  fs.rmSync(temporary, { recursive: true, force: true });
}

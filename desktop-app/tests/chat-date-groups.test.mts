import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
const { groupChatsByActivity } = createRequire(import.meta.url)('../src/renderer/lib/chat-date-groups.ts');
const ts = (y: number, m: number, d: number, h = 12) => new Date(y, m - 1, d, h).getTime() / 1000;
const chat = (id: number, time: number) => ({ id, created_at: time });
const now = new Date(2026, 9, 30, 15);
const items = [chat(1, ts(2026,10,30)), chat(2, ts(2026,10,29)), chat(3, ts(2026,10,27)), chat(4, ts(2026,10,10)), chat(5, ts(2026,8,5)), chat(6, ts(2025,12,31)), chat(7,ts(2026,9,1))];
const groups = groupChatsByActivity(items, now);
assert.deepEqual(groups.map(g => g.key), ['today','yesterday','thisWeek','thisMonth','month:2026-09','month:2026-08','month:2025-12']);
assert.equal(groups.flatMap(g => g.chats).length, items.length);
const promoted = { ...items[5], updated_at: ts(2026,10,30) };
assert.equal(groupChatsByActivity([promoted], now)[0].key, 'today', 'activity supersedes creation, even for old chats');
assert.equal(items[5].created_at, ts(2025,12,31), 'input not mutated');
assert.deepEqual(groupChatsByActivity([],now), []);
assert.equal(groupChatsByActivity([chat(1,ts(2026,2,28))], new Date(2026,2,1,12))[0].key, 'yesterday', 'month boundary');
assert.equal(groupChatsByActivity([chat(1,ts(2026,10,25))], new Date(2026,9,26,12))[0].key,'yesterday','Monday boundary');
assert.equal(groupChatsByActivity([chat(1,ts(2026,10,25))],now)[0].key,'thisMonth','previous week');
const sameDay=[chat(4,ts(2026,10,30)),chat(2,ts(2026,10,30))];
assert.deepEqual(groupChatsByActivity(sameDay,now)[0].chats.map(c=>c.id),[4,2],'keep existing optimistic order');
console.log('chat-date-groups tests passed');

{
  "name": "chatter-desktop",
  "version": "1.9.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/ensure-dev-cookie-encryption.cjs && tsc -p tsconfig.main.json && electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "voices:download": "powershell -ExecutionPolicy Bypass -File scripts/download-default-piper-voices.ps1",
    "i18n:translate": "node ../scripts/translate-i18n.mjs --locales desktop-app/src/renderer/i18n/locales --languages desktop-app/src/renderer/i18n/languages.ts --env .env.i18n",
    "i18n:translate:all": "node ../scripts/translate-i18n.mjs --locales desktop-app/src/renderer/i18n/locales --languages desktop-app/src/renderer/i18n/languages.ts --env .env.i18n --all"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/diff": "^7.0.2",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "file-saver": "^2.0.5",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.38.0",
    "hark": "^1.2.3",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.6",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.0",
    "marked": "^18.0.2",
    "onnxruntime-node": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.9",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/hark": "^1.2.5",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "sass": "^1.99.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.ncherepov.chatter",
    "productName": "Chatter",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**/*",
      "!dist/wakeword-listener.exe",
      "!dist/wakeword-listener/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*",
          "!vosk.tar.gz",
          "!vosk-model-small-ru/**/*",
          "!piper-voices/denis/**/*",
          "!piper-voices/dmitri/**/*"
        ]
      },
      {
        "from": "wakeword",
        "to": "wakeword",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sounds",
        "to": "sounds",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NikitaCherepov",
        "repo": "chatter",
        "releaseType": "draft"
      }
    ]
  }
}

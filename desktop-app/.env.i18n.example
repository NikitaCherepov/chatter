# OpenAI-compatible Chat Completions endpoint. A /v1 base URL is also accepted.
I18N_TRANSLATE_API_URL=https://api.openai.com/v1
I18N_TRANSLATE_API_KEY=
I18N_TRANSLATE_MODEL=gpt-4o-mini

# auto detects openrouter.ai and direct deepseek.com URLs.
# Set this explicitly when using a compatible proxy on another domain.
I18N_TRANSLATE_PROVIDER=auto

# auto uses the provider/model default; none avoids reasoning-token costs.
I18N_TRANSLATE_REASONING_LEVEL=none

# One catalog string per request by default. Increase to reduce request count.
I18N_TRANSLATE_BATCH_SIZE=1
I18N_TRANSLATE_DELAY_MS=0
I18N_TRANSLATE_MAX_RETRIES=3
I18N_TRANSLATE_TIMEOUT_MS=120000
I18N_TRANSLATE_TEMPERATURE=0
I18N_TRANSLATE_JSON_MODE=true

# For local endpoints without authentication:
# I18N_TRANSLATE_ALLOW_NO_KEY=1

# Provider examples: openrouter -> reasoning.effort; deepseek -> thinking/reasoning_effort.
# Supported levels: auto, none, minimal, low, medium, high, xhigh.

# Optional provider-specific headers as a JSON object:
# I18N_TRANSLATE_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"Chatter i18n"}

VITE_API_BASE_URL=http://127.0.0.1:3050

# Optional: override updates feed URL (defaults to VITE_API_BASE_URL + /updates/win/)
# UPDATES_FEED_URL=http://127.0.0.1:3050/updates/win/

# Allowed image MIME types for upload (comma-separated). Defaults to: image/png,image/jpeg,image/webp,image/gif
# VITE_ALLOWED_IMAGE_FORMATS=image/png,image/jpeg,image/webp,image/gif
